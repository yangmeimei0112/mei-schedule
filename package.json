{
  "name": "mei-schedule",
  "private": true,
  "version": "1.0.0",
  "description": "咩時光 MeiSchedule — 咩創意工作室跨五端全能智慧排程系統 (Web / PWA / macOS / Windows / iOS / Android)",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude src/__tests__/e2e_requirements/**",
    "test:e2e": "vitest run src/__tests__/e2e_requirements/",
    "test": "vitest run",
    "verify:schedule": "node --test scripts/verify-schedule.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').mkdirSync('dist-electron', { recursive: true }); require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "build:electron:check": "npm run build:electron && node --test scripts/verify-schedule.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
